    "axios": "^1.16.1",
    "date-fns": "^4.1.0",
    "expo": "^57.0.0",
    "expo-application": "~57.0.2",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-linking": "~57.0.8",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.14",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
